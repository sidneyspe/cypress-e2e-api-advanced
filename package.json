{
  "name": "cypress-e2e-api-advanced",
  "version": "1.0.0",
  "description": "course about cypress advanced using e2e and api tests (Escola Talking About Testing)",
  "main": "cypress.config.js",
  "scripts": {
    "lint": "eslint cypress --ext .js --fix",
    "test": "cypress run",
    "cy:open": "cypress open",
    "precy:run": "node -e \"const fs=require('fs');['cypress/screenshots','cypress/results','cypress/reports'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true})})\"",
    "report:cleanup": "node -e \"const fs=require('fs');['cypress/results/report','cypress/results/json'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true})})\"",
    "video:cleanup": "node -e \"const fs=require('fs');if(fs.existsSync('cypress/videos'))fs.rmSync('cypress/videos',{recursive:true,force:true})\"",
    "screenshots:cleanup": "node -e \"const fs=require('fs');if(fs.existsSync('cypress/screenshots'))fs.rmSync('cypress/screenshots',{recursive:true,force:true})\"",
    "test:e2e": "cypress run --headless --browser chrome",
    "test:e2e:mock": "cypress run --spec \"cypress/e2e/hackerStoriesMock/**/*.cy.js\"",
    "test:e2e:real": "cypress run --spec \"cypress/e2e/hackerStories/**/*.cy.js\"",
    "report:merge": "mochawesome-merge cypress/results/json/*.json > cypress/results/output.json",
    "report:mochawesome": "marge cypress/results/output.json --reportDir cypress/results/mochawesome --inline --charts true",
    "report:custom": "node cypress/report-template/report-generator.js --input cypress/results/output.json --output cypress/results/report --name \"Hacker Stories\" --theme dark",
    "report:generate": "npm run report:mochawesome && npm run report:custom",
    "report:copyAssets": "node cypress/report-template/copy-assets.js",
    "report:open": "node -e \"require('child_process').exec(process.platform==='win32'?'start cypress/results/report/index.html':process.platform==='darwin'?'open cypress/results/report/index.html':'xdg-open cypress/results/report/index.html')\"",
    "cy:all": "npm run precy:run && npm run test && npm run report:merge && npm run report:generate && npm run report:copyAssets",
    "cy:all:open": "npm run cy:all && npm run report:open"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "npm run lint",
      "git add"
    ]
  },
  "keywords": [
    "Cypress intermediate",
    "Talking About Testing",
    "E2E Testing",
    "API Testing"
  ],
  "author": "Sidney Pimentel <sidneyspe@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.2.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-n": "^15.2.0",
    "eslint-plugin-prettier": "5.0.0-alpha.2",
    "eslint-plugin-promise": "^6.0.0",
    "prettier": "^3.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  },
  "dependencies": {
    "@faker-js/faker": "^8.1.0",
    "cypress": "^15.9.0",
    "cypress-localstorage-commands": "^2.2.4",
    "cypress-multi-reporters": "^1.6.3",
    "cypress-plugin-api": "^2.11.1",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1"
  }
}
