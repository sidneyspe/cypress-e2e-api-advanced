{
  "name": "cypress-project",
  "version": "1.0.0",
  "description": "Projeto de automacao de testes com Cypress",
  "main": "cypress.config.ts",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:e2e": "cypress run --spec \"cypress/e2e/**/*.cy.ts\"",
    "cy:run:api": "cypress run --spec \"cypress/api/**/*.cy.ts\"",
    "cy:run:smoke": "cypress run --env grepTags=smoke",
    "cy:run:regression": "cypress run --env grepTags=regression",
    "cy:run:squad:core": "cypress run --env grepTags=@squad:qa-core",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precy:run": "node -e \"const fs=require('fs');['cypress/screenshots','cypress/results'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true})})\"",
    "report:merge": "npx mochawesome-merge cypress/results/json/*.json -o cypress/results/output.json",
    "report:mochawesome": "npx marge cypress/results/output.json --reportDir cypress/results/mochawesome --inline --charts true",
    "report:generate": "npm run report:merge && npm run report:mochawesome",
    "cy:all": "npm run precy:run && npm run cy:run && npm run report:generate",
    "cy:all:open": "npm run cy:all && start cypress/results/mochawesome/mochawesome.html",
    "test": "npm run cy:all"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "keywords": [
    "Cypress",
    "E2E Testing",
    "API Testing",
    "TypeScript"
  ],
  "author": "Sidney Pimentel <sidneyspe@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cypress": "^15.9.0",
    "@cypress/grep": "^4.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "cypress-multi-reporters": "^1.6.3"
  },
  "dependencies": {
    "@faker-js/faker": "^8.1.0",
    "cypress-localstorage-commands": "^2.2.4",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1"
  }
}
