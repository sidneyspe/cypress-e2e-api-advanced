{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["cypress", "node"],
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "cypress/artifacts"],
}
